FROM node:22-bookworm-slim AS deps

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-bookworm-slim AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_LOADER_API
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_FRONT_URL
ARG NEXT_PUBLIC_REF_LINK
ARG NEXT_PUBLIC_DISCORD_CLIENT_ID
ARG NEXT_PUBLIC_TELEGRAM_BOT_LINK
ARG NEXT_PUBLIC_BACKERS_V2
ARG NEXT_PUBLIC_FUNDS_DETAIL_V2
ARG NEXT_PUBLIC_PERSONS_DETAIL_V2
ARG NEXT_PUBLIC_COMPARISON_PERF_LOGS
ARG API_BASE_URL
ARG DISCORD_REDIRECT_URI

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_LOADER_API=${NEXT_PUBLIC_LOADER_API}
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
ENV NEXT_PUBLIC_FRONT_URL=${NEXT_PUBLIC_FRONT_URL}
ENV NEXT_PUBLIC_REF_LINK=${NEXT_PUBLIC_REF_LINK}
ENV NEXT_PUBLIC_DISCORD_CLIENT_ID=${NEXT_PUBLIC_DISCORD_CLIENT_ID}
ENV NEXT_PUBLIC_TELEGRAM_BOT_LINK=${NEXT_PUBLIC_TELEGRAM_BOT_LINK}
ENV NEXT_PUBLIC_BACKERS_V2=${NEXT_PUBLIC_BACKERS_V2}
ENV NEXT_PUBLIC_FUNDS_DETAIL_V2=${NEXT_PUBLIC_FUNDS_DETAIL_V2}
ENV NEXT_PUBLIC_PERSONS_DETAIL_V2=${NEXT_PUBLIC_PERSONS_DETAIL_V2}
ENV NEXT_PUBLIC_COMPARISON_PERF_LOGS=${NEXT_PUBLIC_COMPARISON_PERF_LOGS}
ENV API_BASE_URL=${API_BASE_URL}
ENV DISCORD_REDIRECT_URI=${DISCORD_REDIRECT_URI}

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV NEXT_TELEMETRY_DISABLED=1

RUN groupadd --system --gid 1001 app \
  && useradd --system --uid 1001 --gid app app

COPY --from=builder --chown=app:app /app/public ./public
COPY --from=builder --chown=app:app /app/.next/standalone ./
COPY --from=builder --chown=app:app /app/.next/static ./.next/static

USER app

EXPOSE 3000

CMD ["node", "server.js"]
